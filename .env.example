# LexPrime AI - Public Environment Template
# Copy this file to .env and provide your credentials.
# NEVER commit .env to Git.

# Gemini API Configuration (Development / Testing)
# In production, route via secure server-side proxy (Firebase Functions / Cloud Run)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=astra-ai-eb8fc
VITE_FIREBASE_STORAGE_BUCKET=astra-ai-eb8fc.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
