rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Rules for the 'analysisHistory' collection
    match /analysisHistory/{analysisId} {
      // Allow create if user is authenticated and document's userId matches auth UID
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.title is string;

      // Allow read, update, and delete only if the document belongs to the authenticated user
      allow read, update, delete: if isAuthenticated() && 
                                   resource.data.userId == request.auth.uid;
    }

    // Rules for the 'users' profile collection
    match /users/{userId} {
      // Allow users to read, create, and update only their own profile
      allow read, create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Rules for the 'messages' collection (Chatbot & Lawyer messaging)
    match /messages/{messageId} {
      // Ensure messages are strictly scoped to the authenticated user
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && 
                                   resource.data.userId == request.auth.uid;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
